{
  "name": "wasiyah-api",
  "version": "0.1",
  "private": true,
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "html-minifier": "npm:html-minifier-terser@7.2.0",
      "fastify": "^5.3.2",
      "vite": "^6.3.4"
    }
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"../src/**/*.ts\" \"tests/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --color",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_ENV=test FORCE_COLOR=1 pnpm prepare:test && NODE_ENV=test FORCE_COLOR=1 vitest --run",
    "test:watch": " NODE_ENV=test vitest watch",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.js",
    "migration:create": "typeorm migration:create src/migrations/migrations",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts src/migrations/migrations",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "prepare:test": "ts-node scripts/create-test-db.ts",
    "prepare": "husky",
    "make:repository": "ts-node scripts/generate-repository.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^11.0.20",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.20",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.20",
    "@nestjs/swagger": "^11.1.5",
    "@nestjs/typeorm": "^11.0.0",
    "argon2": "^0.41.1",
    "axios": "^1.8.4",
    "chalk": "^5.4.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "html-minifier-terser": "^7.2.0",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.22",
    "typeorm-naming-strategies": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.25.1",
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.0.20",
    "@swc/cli": "^0.7.3",
    "@swc/core": "^1.11.21",
    "@types/node": "^22.14.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "3.1.2",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-file-progress": "^3.0.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2"
  }
}
